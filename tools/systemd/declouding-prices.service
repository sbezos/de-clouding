[Unit]
Description=de-clouding.com: weekly eBay price refresh for the curated parts tables
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/homelab

[Service]
Type=oneshot
User=sbezos
Group=sbezos
WorkingDirectory=/home/sbezos/sites/declouding
EnvironmentFile=/home/sbezos/.config/declouding/ebay.env
ExecStart=/home/sbezos/sites/declouding/tools/refresh-prices.sh
TimeoutStartSec=20m
StandardOutput=append:/mnt/homelab/logs/declouding/prices.log
StandardError=append:/mnt/homelab/logs/declouding/prices.log
