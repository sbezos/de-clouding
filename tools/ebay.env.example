# ~/.config/declouding/ebay.env  (chmod 600). Read by declouding-prices.service and refresh-prices.sh.
# eBay developer keyset (production, Browse API, client-credentials). Keep the Cert ID in Keeper/Proton Pass too.
EBAY_APP_ID=
EBAY_CERT_ID=
# Shipping-estimate destination for price+shipping; any US zip, not necessarily yours.
EBAY_ZIP=20001
# Optional: Home Assistant push when a refresh needs a human look (same names as /etc/podd/env).
HA_URL=http://homeassistant.homelab:8123
HA_TOKEN=
HA_NOTIFY=notify.mobile_app_CHANGEME
